# GeoSense Satellite Landslide Detection Configuration

# Phase 1 Hugging Face Model Repository
MODEL_REPO_ID=srivassid/prithvi-landslide
MODEL_REVISION=main
MODEL_CHECKPOINT_FILE=last.ckpt
MODEL_CONFIG_FILE=config.yaml

# Phase 2 Hugging Face Multimodal Susceptibility Model
PHASE2_MODEL_REPO_ID=vinukatashidu/landslide-detection-multimodal
PHASE2_MODEL_REVISION=8e972570b1f896f6fdc14de4d436df496342d3f0
PHASE2_MODEL_CHECKPOINT=multimodal_stage2.pth
GEOSENSE_DB_PATH=geosense.db

# Phase 3 Weather & Dynamic Risk Configuration
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_STALE_HOURS=3.0
AWI_DECAY_K=0.85
WEIGHT_OBSERVED_RAINFALL=0.30
WEIGHT_FORECAST_RAINFALL=0.20
WEIGHT_SUSCEPTIBILITY=0.25
WEIGHT_TERRAIN=0.15
WEIGHT_SATELLITE_DETECTION=0.10
RISK_THRESHOLD_MODERATE=25.0
RISK_THRESHOLD_HIGH=50.0
RISK_THRESHOLD_CRITICAL=75.0

# Local directories (relative to backend or absolute paths)
MODEL_DIR=model_weights
UPLOAD_DIR=uploads
RESULT_DIR=results

# Device configuration: auto, cpu, or cuda
DEVICE=auto

# Server configuration
HOST=0.0.0.0
PORT=8000

# Phase 9 Email (SMTP) & Firebase Cloud Messaging (FCM) — Never commit real secrets
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
FIREBASE_CREDENTIALS_PATH=
ALERT_RAIN_24H_MM=60.0
ALERT_FORECAST_24H_MM=75.0
ALERT_SCORE_DELTA=15.0
